{
  "name": "rescuebite-customer-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "concurrently -k -n api,expo -c green,cyan \"npm run server\" \"expo start\"",
    "server": "tsx server/index.ts",
    "android": "concurrently -k -n api,expo -c green,cyan \"npm run server\" \"expo start --android\"",
    "ios": "concurrently -k -n api,expo -c green,cyan \"npm run server\" \"expo start --ios\"",
    "web": "concurrently -k -n api,expo -c green,cyan \"npm run server\" \"expo start --web --localhost\""
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "@tanstack/react-query": "^5.101.0",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.0",
    "expo": "^57.0.20",
    "expo-asset": "~57.0.16",
    "expo-constants": "~57.0.17",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.19",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "typescript": "~6.0.3",
    "zustand": "^5.0.14"
  },
  "private": true,
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "concurrently": "^9.2.1",
